{
  "expo": {
    "name": "いしけん！トーク",
    "slug": "ishiken-talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.co.ryuride.ishikentalk"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "jp.co.ryuride.ishikentalk"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "いしけん！トーク",
      "shortName": "いしけんトーク",
      "themeColor": "#8E6AD8",
      "backgroundColor": "#FAF7FF"
    },
    "owner": "ryuride",
    "extra": {
      "eas": {
        "projectId": "5f414ec5-cc2d-47b2-b933-6143b3a60483"
      }
    },
    "plugins": [
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#8E6AD8",
          "defaultChannel": "morning"
        }
      ]
    ]
  }
}